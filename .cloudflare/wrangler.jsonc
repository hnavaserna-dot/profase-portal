// La copia de crmprofase.com.mx en Cloudflare (plan B por si se cae GitHub). La pone
// profase-datos/herramientas/cloudflare/reparte.py: no se cambia a mano.
{
  "name": "crmprofase",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "MARCOS": "'self'",
    "MARCOS_SALA": "'self' https://*.quosistemas.com"
  }
}
